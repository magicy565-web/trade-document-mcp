      ]
    },
    {
      "region": "TR",
      "sources": [
        "TR-ITA"
      ],
      "purpose": "country-specific import context",
      "review": "secondary source only; no blocking rule",
      "checks": [
        "Confirm local official source and applicability"
      ]
    },
    {
      "region": "MA",
      "sources": [
        "MA-ITA"
      ],
      "purpose": "country-specific import context",
      "review": "secondary source only; no blocking rule",
      "checks": [
        "Confirm local official source and applicability"
      ]
    }
  ]
}
